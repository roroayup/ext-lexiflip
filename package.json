{
  "name": "ext-lexiflip",
  "version": "1.1.0",
  "private": true,
  "description": "Lexiflip: vocabulary flashcards from web pages, documents and your own words (Chrome, Edge, Firefox).",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:chrome": "node scripts/build.mjs chrome",
    "build:edge": "node scripts/build.mjs edge",
    "build:firefox": "node scripts/build.mjs firefox",
    "icons": "node scripts/make-icons.mjs",
    "test": "node --test",
    "lint:firefox": "npx --yes web-ext lint --source-dir dist/firefox"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "pdfjs-dist": "4.10.38"
  }
}
